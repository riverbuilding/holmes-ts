{
  "name": "holmes-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript port of HolmesGPT's local-Docker diagnostic toolset.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "evaluate:fixtures": "npm run build && node dist/evaluation/cli.js",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "prettier": "^3.8.2"
  }
}
