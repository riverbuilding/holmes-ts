{
  "name": "holmes-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript port of HolmesGPT's local-Docker diagnostic toolset.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist",
    "evaluate:fixtures": "npm run build && node dist/evaluation/cli.js",
    "evaluate:restart-loop": "npm run build && node dist/live-evaluation/cli.js",
    "test": "npm run test:deterministic",
    "test:deterministic": "npm run build && node --test dist/**/*.test.js",
    "test:e2e": "npm run build && RUN_LIVE_DOCKER_E2E=1 node --test dist/tests/restart-loop.e2e.test.js",
    "test:provider": "npm run build && node --test dist/tests/openai-compatible-provider.integration.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "prettier": "^3.8.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
