# LLM credentials. Keep real values in ignored .env or CI secrets; the CLI does not load .env automatically.
LLM_API_KEY=
# Optional overrides. Defaults are openrouter/free and https://openrouter.ai/api/v1.
LLM_MODEL=
LLM_BASE_URL=
# Optional model request timeout in milliseconds (default: 30000).
LLM_MODEL_TIMEOUT_MS=
# Optional Docker subprocess timeout in milliseconds (default: 10000). Used only for live Docker investigations.
DOCKER_SUBPROCESS_TIMEOUT_MS=
